{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git ls-files*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git branch*": "allow",
      "git checkout -b *": "allow",
      "git tag*": "allow",
      "python agent.py *": "allow",
      "python scripts/*": "allow",
      "python -m pytest*": "allow",
      "python -m unittest*": "allow",
      "python -m localcaption*": "allow",
      "python -m motor *": "allow",
      "opencode run *": "allow",
      "opencode models*": "allow",
      "opencode --version": "allow",
      "yt-dlp *": "allow",
      "npx skills *": "allow",
      "powershell -ExecutionPolicy Bypass -File scripts/*": "allow",
      "Get-ChildItem*": "allow",
      "Get-Content*": "allow",
      "Get-ScheduledTask*": "allow",
      "Get-NetTCPConnection*": "allow",
      "Select-String*": "allow",
      "Test-Path*": "allow",
      "netstat*": "allow",
      "findstr*": "allow",
      "dir*": "allow",
      "type *": "allow",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "rm*": "ask",
      "rmdir*": "ask",
      "del*": "ask",
      "Remove-Item*": "ask",
      "*tokens.priv*": "ask",
      "*cookies.priv*": "ask"
    },
    "edit": {
      "*": "allow",
      "golden/datasets/**": "ask",
      "golden/golden.jsonl": "ask",
      "golden/results.jsonl": "ask",
      "chain_heads.json": "ask",
      "evals/**": "ask",
      "tasks/*/dev.jsonl": "ask",
      "tasks/*/grader.py": "ask",
      "tasks/*/task.json": "ask",
      "opencode.json": "ask"
    },
    "read": {
      "*": "allow",
      "*tokens.priv*": "ask",
      "*cookies.priv*": "ask"
    },
    "external_directory": {
      "*": "ask",
      "~/SIAFB-examen/**": "deny"
    }
  }
}
