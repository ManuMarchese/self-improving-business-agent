{"id": "mbpp-554", "input": {"enunciado": "Write a python function which takes a list of integers and only returns the odd ones.", "firma_ejemplo": "assert Split([1,2,3,4,5,6]) == [1,3,5]"}, "expected": {"tests": ["assert Split([1,2,3,4,5,6]) == [1,3,5]", "assert Split([10,11,12,13]) == [11,13]", "assert Split([7,8,9,1]) == [7,9,1]"], "test_imports": []}}
{"id": "mbpp-555", "input": {"enunciado": "Write a python function to find the difference between the sum of cubes of the first n natural numbers and the sum of the first n natural numbers.", "firma_ejemplo": "assert difference(3) == 30"}, "expected": {"tests": ["assert difference(3) == 30", "assert difference(5) == 210", "assert difference(2) == 6"], "test_imports": []}}
{"id": "mbpp-556", "input": {"enunciado": "Write a python function to count the number of pairs whose xor value is odd.", "firma_ejemplo": "assert find_Odd_Pair([5,4,7,2,1],5) == 6"}, "expected": {"tests": ["assert find_Odd_Pair([5,4,7,2,1],5) == 6", "assert find_Odd_Pair([7,2,8,1,0,5,11],7) == 12", "assert find_Odd_Pair([1,2,3],3) == 2"], "test_imports": []}}
{"id": "mbpp-557", "input": {"enunciado": "Write a function to toggle the case of all characters in a string.", "firma_ejemplo": "assert toggle_string(\"Python\")==(\"pYTHON\")"}, "expected": {"tests": ["assert toggle_string(\"Python\")==(\"pYTHON\")", "assert toggle_string(\"Pangram\")==(\"pANGRAM\")", "assert toggle_string(\"LIttLE\")==(\"liTTle\")"], "test_imports": []}}
{"id": "mbpp-558", "input": {"enunciado": "Write a python function to find the sum of the per-digit difference between two integers.", "firma_ejemplo": "assert digit_distance_nums(1,2) == 1"}, "expected": {"tests": ["assert digit_distance_nums(1,2) == 1", "assert digit_distance_nums(23,56) == 6", "assert digit_distance_nums(123,256) == 7"], "test_imports": []}}
{"id": "mbpp-559", "input": {"enunciado": "Write a function to find the sum of the largest contiguous sublist in the given list.", "firma_ejemplo": "assert max_sub_array_sum([-2, -3, 4, -1, -2, 1, 5, -3], 8) == 7"}, "expected": {"tests": ["assert max_sub_array_sum([-2, -3, 4, -1, -2, 1, 5, -3], 8) == 7", "assert max_sub_array_sum([-3, -4, 5, -2, -3, 2, 6, -4], 8) == 8", "assert max_sub_array_sum([-4, -5, 6, -3, -4, 3, 7, -5], 8) == 10"], "test_imports": []}}
{"id": "mbpp-560", "input": {"enunciado": "Write a function to find the union of the elements of two given tuples and output them in sorted order.", "firma_ejemplo": "assert union_elements((3, 4, 5, 6),(5, 7, 4, 10) ) == (3, 4, 5, 6, 7, 10)"}, "expected": {"tests": ["assert union_elements((3, 4, 5, 6),(5, 7, 4, 10) ) == (3, 4, 5, 6, 7, 10)", "assert union_elements((1, 2, 3, 4),(3, 4, 5, 6) ) == (1, 2, 3, 4, 5, 6)", "assert union_elements((11, 12, 13, 14),(13, 15, 16, 17) ) == (11, 12, 13, 14, 15, 16, 17)"], "test_imports": []}}
{"id": "mbpp-562", "input": {"enunciado": "Write a python function to find the length of the longest sublists.", "firma_ejemplo": "assert Find_Max_Length([[1],[1,4],[5,6,7,8]]) == 4"}, "expected": {"tests": ["assert Find_Max_Length([[1],[1,4],[5,6,7,8]]) == 4", "assert Find_Max_Length([[0,1],[2,2,],[3,2,1]]) == 3", "assert Find_Max_Length([[7],[22,23],[13,14,15],[10,20,30,40,50]]) == 5"], "test_imports": []}}
{"id": "mbpp-563", "input": {"enunciado": "Write a function to extract values between quotation marks from a string.", "firma_ejemplo": "assert extract_values('\"Python\", \"PHP\", \"Java\"')==['Python', 'PHP', 'Java']"}, "expected": {"tests": ["assert extract_values('\"Python\", \"PHP\", \"Java\"')==['Python', 'PHP', 'Java']", "assert extract_values('\"python\",\"program\",\"language\"')==['python','program','language']", "assert extract_values('\"red\",\"blue\",\"green\",\"yellow\"')==['red','blue','green','yellow']"], "test_imports": []}}
{"id": "mbpp-564", "input": {"enunciado": "Write a python function which takes a list of integers and counts the number of possible unordered pairs where both elements are unequal.", "firma_ejemplo": "assert count_Pairs([1,2,1],3) == 2"}, "expected": {"tests": ["assert count_Pairs([1,2,1],3) == 2", "assert count_Pairs([1,1,1,1],4) == 0", "assert count_Pairs([1,2,3,4,5],5) == 10"], "test_imports": []}}
