{"id": "mbpp-796", "input": {"enunciado": "Write function to find the sum of all items in the given dictionary.", "firma_ejemplo": "assert return_sum({'a': 100, 'b':200, 'c':300}) == 600"}, "expected": {"tests": ["assert return_sum({'a': 100, 'b':200, 'c':300}) == 600", "assert return_sum({'a': 25, 'b':18, 'c':45}) == 88", "assert return_sum({'a': 36, 'b':39, 'c':49}) == 124"], "test_imports": []}}
{"id": "mbpp-797", "input": {"enunciado": "Write a python function to find the sum of all odd natural numbers within the range l and r.", "firma_ejemplo": "assert sum_in_range(2,5) == 8"}, "expected": {"tests": ["assert sum_in_range(2,5) == 8", "assert sum_in_range(5,7) == 12", "assert sum_in_range(7,13) == 40"], "test_imports": []}}
{"id": "mbpp-800", "input": {"enunciado": "Write a function to remove all whitespaces from a string.", "firma_ejemplo": "assert remove_all_spaces('python  program')==('pythonprogram')"}, "expected": {"tests": ["assert remove_all_spaces('python  program')==('pythonprogram')", "assert remove_all_spaces('python   programming    language')==('pythonprogramminglanguage')", "assert remove_all_spaces('python                     program')==('pythonprogram')", "assert remove_all_spaces('   python                     program')=='pythonprogram'"], "test_imports": []}}
{"id": "mbpp-801", "input": {"enunciado": "Write a python function to count the number of equal numbers from three given integers.", "firma_ejemplo": "assert test_three_equal(1,1,1) == 3"}, "expected": {"tests": ["assert test_three_equal(1,1,1) == 3", "assert test_three_equal(-1,-2,-3) == 0", "assert test_three_equal(1,2,2) == 2"], "test_imports": []}}
{"id": "mbpp-802", "input": {"enunciado": "Write a python function to count the number of rotations required to generate a sorted array. https://www.geeksforgeeks.org/count-of-rotations-required-to-generate-a-sorted-array/", "firma_ejemplo": "assert count_rotation([3,2,1]) == 1"}, "expected": {"tests": ["assert count_rotation([3,2,1]) == 1", "assert count_rotation([4,5,1,2,3]) == 2", "assert count_rotation([7,8,9,1,2,3]) == 3", "assert count_rotation([1,2,3]) == 0", "assert count_rotation([1,3,2]) == 2"], "test_imports": []}}
{"id": "mbpp-803", "input": {"enunciado": "Write a function to check whether the given number is a perfect square or not. https://www.geeksforgeeks.org/check-if-given-number-is-perfect-square-in-cpp/", "firma_ejemplo": "assert not is_perfect_square(10)"}, "expected": {"tests": ["assert not is_perfect_square(10)", "assert is_perfect_square(36)", "assert not is_perfect_square(14)", "assert is_perfect_square(14*14)", "assert not is_perfect_square(125)", "assert is_perfect_square(125*125)"], "test_imports": []}}
{"id": "mbpp-805", "input": {"enunciado": "Write a function that returns the list in a list of lists whose sum of elements is the highest.", "firma_ejemplo": "assert max_sum_list([[1,2,3], [4,5,6], [10,11,12], [7,8,9]])==[10, 11, 12]"}, "expected": {"tests": ["assert max_sum_list([[1,2,3], [4,5,6], [10,11,12], [7,8,9]])==[10, 11, 12]", "assert max_sum_list([[3,2,1], [6,5,4], [12,11,10]])==[12,11,10]", "assert max_sum_list([[2,3,1]])==[2,3,1]"], "test_imports": []}}
